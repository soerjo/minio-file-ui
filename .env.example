# Application Configuration
NEXT_PUBLIC_APP_NAME="My App"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional browser-side override of the API base URL. This is the single source
# of truth for the "/api" prefix: API_ROUTES values are prefixed with it, so a
# direct browser-to-BE URL must include the trailing "/api"
# (e.g. "https://api.example.com/api").
# Leave empty to use the relative "/api" path (proxied by the Next.js rewrite below).
NEXT_PUBLIC_API_URL=""

# Server-side target that the "/api/:path*" rewrite proxies to.
# NOT prefixed with NEXT_PUBLIC_ — kept server-only so it is never exposed to the browser.
API_PROXY_TARGET="http://localhost:3000"
